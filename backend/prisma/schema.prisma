generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model admin {
  user_id        String           @id(map: "admin_new_pkey") @db.Uuid
  role_id        String           @db.Uuid
  status         String           @default("active") @db.VarChar(20)
  last_login_at  DateTime?        @db.Timestamptz(6)
  admin_role     admin_role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "admin_new_role_id_fkey")
  app_user       app_user         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_new_user_id_fkey")
  auth_session   auth_session[]
  password_reset password_reset[]
  refund         refund[]
  support_ticket support_ticket[]

  @@index([role_id], map: "idx_admin_new_role")
}

model admin_role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique @db.VarChar(50)
  permissions String
  description String?
  admin       admin[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model app_user {
  id                                                    String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                                  String                    @db.VarChar(120)
  email                                                 String                    @unique @db.VarChar(255)
  phone                                                 String                    @unique @db.VarChar(20)
  password_hash                                         String                    @db.VarChar(255)
  role                                                  String                    @db.VarChar(20)
  status                                                String                    @default("pending_verification") @db.VarChar(30)
  home_city_id                                          String?                   @db.Uuid
  profile_photo_url                                     String?
  date_of_birth                                         DateTime?                 @db.Date
  gender                                                String?                   @db.VarChar(20)
  is_email_verified                                     Boolean                   @default(false)
  is_phone_verified                                     Boolean                   @default(false)
  created_at                                            DateTime                  @default(now()) @db.Timestamptz(6)
  last_login_at                                         DateTime?                 @db.Timestamptz(6)
  admin                                                 admin?
  city                                                  city?                     @relation(fields: [home_city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  auth_session                                          auth_session[]
  chat_message                                          chat_message[]
  driver                                                driver?
  emergency_contact                                     emergency_contact[]
  notification                                          notification[]
  notification_preference                               notification_preference[]
  parcel_delivery_parcel_delivery_receiver_idToapp_user parcel_delivery[]         @relation("parcel_delivery_receiver_idToapp_user")
  parcel_delivery_parcel_delivery_sender_idToapp_user   parcel_delivery[]         @relation("parcel_delivery_sender_idToapp_user")
  password_reset                                        password_reset[]
  payment_method                                        payment_method[]
  rating_rating_ratee_idToapp_user                      rating[]                  @relation("rating_ratee_idToapp_user")
  rating_rating_rater_idToapp_user                      rating[]                  @relation("rating_rater_idToapp_user")
  rider                                                 rider?
  saved_place                                           saved_place[]
  sos_event                                             sos_event[]
  support_ticket                                        support_ticket[]
  verification_code                                     verification_code[]
  wallet                                                wallet?

  @@index([home_city_id], map: "idx_user_home_city")
  @@index([role], map: "idx_user_role")
  @@index([status], map: "idx_user_status")
}

model audit_log {
  id          BigInt   @id @default(autoincrement())
  actor_id    String?  @db.Uuid
  actor_type  String   @db.VarChar(20)
  action      String   @db.VarChar(80)
  entity_type String?  @db.VarChar(50)
  entity_id   String?  @db.Uuid
  ip_address  String?  @db.VarChar(45)
  diff        String?
  ts          DateTime @default(now()) @db.Timestamptz(6)

  @@index([actor_id, ts(sort: Desc)], map: "idx_audit_actor")
  @@index([entity_type, entity_id], map: "idx_audit_entity")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model auth_session {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String?   @db.Uuid
  admin_id           String?   @db.Uuid
  refresh_token_hash String    @unique @db.VarChar(255)
  ip_address         String?   @db.VarChar(45)
  user_agent         String?
  device_id          String?   @db.VarChar(120)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  expires_at         DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  admin              admin?    @relation(fields: [admin_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  app_user           app_user? @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([admin_id], map: "idx_session_admin")
  @@index([user_id], map: "idx_session_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model chat_message {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ride_id     String    @db.Uuid
  sender_id   String    @db.Uuid
  sender_role String    @db.VarChar(10)
  message     String
  is_read     Boolean   @default(false)
  sent_at     DateTime  @default(now()) @db.Timestamptz(6)
  read_at     DateTime? @db.Timestamptz(6)
  ride        ride      @relation(fields: [ride_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  app_user    app_user  @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([ride_id, sent_at], map: "idx_chat_ride")
}

model city {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country_id        String              @db.Uuid
  name              String              @db.VarChar(120)
  timezone          String              @db.VarChar(50)
  center_lat        Float?
  center_lng        Float?
  is_active         Boolean             @default(true)
  app_user          app_user[]
  country           country             @relation(fields: [country_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  driver            driver[]
  fare_estimate     fare_estimate[]
  incentive_program incentive_program[]
  parcel_delivery   parcel_delivery[]
  ride              ride[]
  ride_tracking     ride_tracking[]
  rider             rider[]
  saved_place       saved_place[]
  sos_event         sos_event[]
  vehicle           vehicle[]
  zone              zone[]

  @@index([country_id], map: "idx_city_country")
}

model country {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @db.VarChar(100)
  iso_code            String                @unique @db.Char(2)
  currency            String                @db.Char(3)
  phone_prefix        String                @db.VarChar(5)
  center_lat          Float?
  center_lng          Float?
  is_active           Boolean               @default(true)
  city                city[]
  driver_bank_account driver_bank_account[]
  parcel_delivery     parcel_delivery[]
  ride                ride[]
  ride_tracking       ride_tracking[]
  rider               rider[]
  saved_place         saved_place[]
  sos_event           sos_event[]
  zone                zone[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model driver {
  user_id                                   String                @id @db.Uuid
  license_number                            String                @unique @db.VarChar(50)
  license_expiry                            DateTime              @db.Date
  kyc_status                                String                @default("not_started") @db.VarChar(20)
  rating_avg                                Decimal?              @default(5.00) @db.Decimal(3, 2)
  total_rides                               Int                   @default(0)
  online_status                             String                @default("offline") @db.VarChar(20)
  active_vehicle_id                         String?               @db.Uuid
  current_city_id                           String?               @db.Uuid
  last_known_lat                            Float?
  last_known_lng                            Float?
  last_known_ts                             DateTime?             @db.Timestamptz(6)
  lifetime_earnings                         Decimal               @default(0) @db.Decimal(14, 2)
  current_balance                           Decimal               @default(0) @db.Decimal(14, 2)
  vehicle_driver_active_vehicle_idTovehicle vehicle?              @relation("driver_active_vehicle_idTovehicle", fields: [active_vehicle_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "driver_active_vehicle_fk")
  city                                      city?                 @relation(fields: [current_city_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  app_user                                  app_user              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  driver_bank_account                       driver_bank_account[]
  driver_document                           driver_document[]
  driver_incentive                          driver_incentive[]
  driver_payout                             driver_payout[]
  parcel_delivery                           parcel_delivery[]
  parcel_tracking                           parcel_tracking[]
  ride                                      ride[]
  ride_dispatch                             ride_dispatch[]
  ride_tracking                             ride_tracking[]
  tip                                       tip[]
  vehicle_vehicle_driver_idTodriver         vehicle[]             @relation("vehicle_driver_idTodriver")

  @@index([current_city_id], map: "idx_driver_current_city")
  @@index([kyc_status], map: "idx_driver_kyc")
  @@index([online_status], map: "idx_driver_online")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
